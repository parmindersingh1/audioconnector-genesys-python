# .env file for WebSocket server

# Server configuration
PORT=8080

# Your existing agent service URL
# This should point to your Python service that creates LiveKit agents
AGENT_SERVICE_URL=https://livekit.voicebot.whilter.ai

LIVEKIT_WS_URL=wss://lks.whilter.ai

# Optional: If you need authentication for your agent service
AGENT_SERVICE_API_KEY=your_agent_service_api_key

# Logging level
LOG_LEVEL=INFO